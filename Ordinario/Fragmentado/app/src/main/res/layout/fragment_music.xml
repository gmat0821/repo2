<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/music_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/music_fragment_title"
            android:textColor="@color/music_accent"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.1" />

        <!-- Album Cover Placeholder Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="@color/music_card_bg"
            app:cardCornerRadius="24dp"
            app:cardElevation="8dp"
            app:strokeColor="@color/music_accent"
            app:strokeWidth="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_album_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/icon_album"
                    android:textSize="80sp" />

                <TextView
                    android:id="@+id/tv_playback_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/status_paused"
                    android:textColor="@color/music_accent"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Track Info -->
        <TextView
            android:id="@+id/tv_track_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/song_title_1"
            android:textColor="@color/music_text_light"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_track_artist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/song_artist_1"
            android:textColor="#9CA3AF"
            android:textSize="14sp" />

        <!-- SeekBar Progress -->
        <SeekBar
            android:id="@+id/seek_bar_music"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:max="100"
            android:progress="35"
            android:progressTint="@color/music_accent"
            android:thumbTint="@color/music_accent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_time_current"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/time_initial"
                android:textColor="#9CA3AF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_time_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/time_total"
                android:textColor="#9CA3AF"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Media Player Controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_prev"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:text="@string/btn_prev_text"
                android:textColor="@color/white"
                android:textSize="20sp"
                app:backgroundTint="@color/music_card_bg" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_play_pause"
                style="@style/Widget.Material3.Button"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginHorizontal="20dp"
                android:backgroundTint="@color/music_accent"
                android:text="@string/btn_play_text"
                android:textColor="@color/music_bg"
                android:textSize="28sp"
                app:cornerRadius="36dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_next"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:text="@string/btn_next_text"
                android:textColor="@color/white"
                android:textSize="20sp"
                app:backgroundTint="@color/music_card_bg" />
        </LinearLayout>

        <!-- Bass Boost Chip / Extra Option -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_effect"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/effect_off"
            android:textColor="@color/music_accent"
            android:textSize="12sp"
            app:strokeColor="@color/music_accent" />

    </LinearLayout>
</ScrollView>
