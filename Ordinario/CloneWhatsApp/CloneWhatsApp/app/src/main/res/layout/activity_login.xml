<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="28dp"
    android:gravity="center"
    android:background="@color/chiikawa_bg">

    <ImageView
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:src="@drawable/ic_chiikawa_logo"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="WhatsApp Chiikawa"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="@color/chiikawa_text_dark"
        android:layout_marginBottom="32dp"/>

    <EditText
        android:id="@+id/etEmail"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:hint="Correo Electrónico"
        android:textColor="@color/chiikawa_text_dark"
        android:textColorHint="@color/chiikawa_text_muted"
        android:background="@drawable/bg_rounded_input"
        android:paddingHorizontal="16dp"
        android:inputType="textEmailAddress"
        android:autofillHints="emailAddress"
        android:layout_marginBottom="14dp"/>

    <EditText
        android:id="@+id/etPassword"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:hint="Contraseña"
        android:textColor="@color/chiikawa_text_dark"
        android:textColorHint="@color/chiikawa_text_muted"
        android:background="@drawable/bg_rounded_input"
        android:paddingHorizontal="16dp"
        android:inputType="textPassword"
        android:autofillHints="password"
        android:layout_marginBottom="24dp"/>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnLogin"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:background="@drawable/bg_button_teal"
        app:backgroundTint="@null"
        android:text="Iniciar Sesión"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:textSize="15sp"/>

    <TextView
        android:id="@+id/tvForgotPassword"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="¿Olvidaste tu contraseña?"
        android:textColor="@color/chiikawa_accent"
        android:layout_marginTop="20dp"
        android:padding="6dp"/>

    <TextView
        android:id="@+id/tvRegisterLink"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="¿No tienes cuenta? Regístrate aquí"
        android:textColor="@color/chiikawa_accent"
        android:layout_marginTop="10dp"
        android:padding="6dp"/>

</LinearLayout>