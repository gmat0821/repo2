<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="3dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:background="@drawable/bg_bubble_sent"
        android:orientation="vertical"
        android:padding="10dp"
        android:maxWidth="280dp">

        <!-- Mensaje de Texto Normal -->
        <TextView
            android:id="@+id/tvSentContent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mensaje"
            android:textSize="14sp"
            android:textColor="@color/chiikawa_text_dark"/>

        <!-- Reproductor Intuitivo de Nota de Voz Estilo IG/WhatsApp -->
        <LinearLayout
            android:id="@+id/layoutAudioSent"
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="4dp"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/btnPlayAudioSent"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_button_teal"
                android:src="@android:drawable/ic_media_play"
                android:contentDescription="Reproducir audio"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="10dp">

                <SeekBar
                    android:id="@+id/seekBarAudioSent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="0dp"
                    android:progressTint="@color/chiikawa_accent"
                    android:thumbTint="@color/chiikawa_accent"/>

                <TextView
                    android:id="@+id/tvAudioDurationSent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎙️ Nota de voz"
                    android:textSize="11sp"
                    android:textColor="@color/chiikawa_text_muted"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_gravity="end"
            android:layout_marginTop="2dp">

            <TextView
                android:id="@+id/tvSentTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10:00"
                android:textSize="10sp"
                android:textColor="@color/chiikawa_text_muted"/>

            <TextView
                android:id="@+id/tvSentStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" ✔"
                android:textSize="10sp"
                android:textColor="@color/chiikawa_accent"
                android:layout_marginStart="3dp"/>
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>