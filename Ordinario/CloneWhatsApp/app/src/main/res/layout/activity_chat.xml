<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootChatLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="@color/chiikawa_bg">

    <!-- Header del Chat -->
    <LinearLayout
        android:id="@+id/headerChat"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:background="@color/chiikawa_header"
        android:paddingHorizontal="16dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/imgChatAvatar"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_chiikawa_logo"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/tvChatName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cargando..."
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvChatStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="En línea"
                android:textColor="@color/white"
                android:textSize="12sp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Lista de Mensajes (Se ajusta dinámicamente con el teclado) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMessages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp"/>

    <!-- Contenedor Inferior de Escritura y Audio -->
    <FrameLayout
        android:id="@+id/layoutInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white">

        <!-- BARRA 1: Input Normal de Texto -->
        <LinearLayout
            android:id="@+id/layoutTextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp"
            android:gravity="center_vertical"
            android:visibility="visible">

            <EditText
                android:id="@+id/etMessageInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="44dp"
                android:layout_weight="1"
                android:hint="Escribe un mensaje... 😊🌸"
                android:background="@drawable/bg_rounded_input"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp"
                android:textSize="14sp"
                android:inputType="textMultiLine|textShortMessage"
                android:maxLines="4"
                android:textColor="@color/chiikawa_text_dark"/>

            <ImageButton
                android:id="@+id/btnAudioRecord"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_button_teal"
                android:src="@android:drawable/ic_btn_speak_now"
                android:contentDescription="Grabar Audio"
                android:layout_marginStart="6dp"/>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSend"
                android:layout_width="65dp"
                android:layout_height="44dp"
                android:text="Enviar"
                android:textSize="12sp"
                android:textColor="@color/white"
                android:background="@drawable/bg_button_teal"
                app:backgroundTint="@null"
                android:layout_marginStart="6dp"/>
        </LinearLayout>

        <!-- BARRA 2: Animación de Grabación Estilo WhatsApp (Oculta por defecto) -->
        <LinearLayout
            android:id="@+id/layoutRecordingInput"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:padding="8dp"
            android:gravity="center_vertical"
            android:visibility="gone"
            android:background="#FFF0F3">

            <ImageView
                android:id="@+id/imgRecordingDot"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_chiikawa_logo"
                android:layout_marginStart="12dp"/>

            <TextView
                android:id="@+id/tvRecordingTimer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="00:00"
                android:textColor="@color/chiikawa_accent"
                android:textSize="17sp"
                android:textStyle="bold"
                android:layout_marginStart="12dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Grabando audio..."
                android:textColor="@color/chiikawa_text_muted"
                android:textSize="13sp"
                android:layout_marginEnd="12dp"/>

            <ImageButton
                android:id="@+id/btnStopRecord"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_button_teal"
                android:src="@android:drawable/ic_menu_send"
                android:contentDescription="Enviar Audio"/>
        </LinearLayout>

    </FrameLayout>

</LinearLayout>