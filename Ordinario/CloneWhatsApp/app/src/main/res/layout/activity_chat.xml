<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kakao_bg">

    <!-- Header del Chat -->
    <LinearLayout
        android:id="@+id/headerChat"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:background="@color/kakao_dark"
        android:paddingHorizontal="16dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/imgChatAvatar"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="@mipmap/ic_launcher_round"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/tvChatName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Contacto Kakao"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvChatStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="En línea"
                android:textColor="@color/kakao_light_teal"
                android:textSize="12sp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Lista de Mensajes -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMessages"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/headerChat"
        android:layout_above="@+id/layoutInput"
        android:padding="8dp"/>

    <!-- Input Bar Estilo KakaoTalk -->
    <LinearLayout
        android:id="@+id/layoutInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="@color/white"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/etMessageInput"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:hint="Escribe un mensaje..."
            android:background="@drawable/bg_rounded_input"
            android:paddingHorizontal="16dp"
            android:textSize="14sp"
            android:textColor="@color/kakao_dark"/>

        <Button
            android:id="@+id/btnSend"
            android:layout_width="70dp"
            android:layout_height="40dp"
            android:text="Enviar"
            android:textSize="12sp"
            android:textColor="@color/white"
            android:background="@drawable/bg_button_teal"
            android:layout_marginStart="8dp"/>
    </LinearLayout>

</RelativeLayout>